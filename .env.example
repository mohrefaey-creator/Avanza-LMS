# Avanza LMS — Environment variables
#
# Copy this file to .env.local and fill in real values:
#   cp .env.example .env.local
#
# .env.local is gitignored. NEVER commit real secrets.
#
# In production these are set in Vercel project settings, not committed:
#   https://vercel.com/<team>/<project>/settings/environment-variables

# Server-only — used by /api/claude.js. Never exposed to the browser.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Public flag — tells the browser the AI proxy is wired up. Safe to expose.
VITE_AI_ENABLED=true
